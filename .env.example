# Copie para ".env" e preencha. O .env NUNCA vai para o GitHub.

# Canal a vigiar
CANAL_URL=https://www.youtube.com/@gameplayrj

# Chave do Gemini SÓ do robô (crie em um projeto novo no AI Studio, para não dividir o limite com o assistente)
GEMINI_API_KEY=
MODELO=gemini-3.5-flash-lite
MODELO_RESERVA=gemini-3.5-flash-lite

# Integração com o assistente: o MESMO token tem que estar no .env do assistente-wpp
# Gere com: openssl rand -hex 16
TOKEN_ROBO=
ASSISTENTE_URL=http://assistente:3100
# Quem recebe os cortes (nome igual ao da lista USUARIOS do assistente)
DESTINO=Ryan

# Versão em inglês: separado (manda um vídeo em PT e outro em EN), junto (as duas legendas no mesmo vídeo) ou nao
VERSAO_EN=separado

# ---- Ajustes finos (pode deixar como está) ----
# Nota mínima (0 a 10) que a IA precisa dar para o corte chegar em você
NOTA_MINIMA=6
# Intervalo mínimo entre cortes (segundos) e limite por live
MIN_ENTRE_CORTES_S=600
MAX_CORTES_POR_LIVE=60
# Sensibilidade: chat X vezes mais rápido que o normal, com no mínimo N mensagens em 10s
CHAT_MULTIPLICADOR=3
CHAT_MIN_MSGS=10
# Mensagens com "kkkk", "clipa", "mds"... em 10s para disparar
PALAVRAS_MIN=5
# Minutos de live guardados no disco
BUFFER_MIN=15
# Corte sem resposta é apagado depois de X horas
APAGAR_PENDENTES_H=24
